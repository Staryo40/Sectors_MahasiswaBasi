# Sectors Financial API key (https://sectors.app/api). Never commit the real one.
SECTORS_API_KEY=
# Set to 1 to allow live API calls. Leave empty to serve from cache only.
SECTORS_LIVE=
# Hard limit on total credits spent, checked against the api_calls ledger.
CREDIT_CAP=400
# Exact comma-separated frontend origins allowed by FastAPI in production.
# Example: https://flow-radar.vercel.app
FRONTEND_ORIGINS=
# Telegram brief and interactive bot. CHAT_ID is only required for outbound briefs.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Random secret used to authenticate Telegram's Vercel webhook requests.
TELEGRAM_WEBHOOK_SECRET=
# Email brief (SMTP with STARTTLS). EMAIL_TO takes a comma-separated list.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
