        "name": {
          "type": "string"
        },
        "sector": {
          "type": "string"
        },
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "rank_prev": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "flow_score": {
          "type": "number",
